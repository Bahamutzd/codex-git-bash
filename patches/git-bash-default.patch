+#[cfg(windows)]
+fn find_git_bash_path(
+    git_paths: impl IntoIterator<Item = PathBuf>,
+    bash_paths: impl IntoIterator<Item = PathBuf>,
+) -> Option<PathBuf> {
+    for git_path in git_paths {
+        let Some(mut git_root) = git_path.parent().and_then(std::path::Path::parent) else {
+            continue;
+        };
+        if git_root.file_name().is_some_and(|name| {
+            name.eq_ignore_ascii_case("mingw64") || name.eq_ignore_ascii_case("mingw32")
+        }) && let Some(parent) = git_root.parent()
+        {
+            git_root = parent;
+        }
+        for relative in ["bin/bash.exe", "usr/bin/bash.exe"] {
+            if let Some(path) = file_exists(&git_root.join(relative)) {
+                return Some(path);
+            }
+        }
+    }
+
+    // 跳过 WSL 启动器和应用执行别名，继续查找后续 PATH 项。
+    bash_paths.into_iter().find_map(|path| {
+        let normalized = path
+            .to_string_lossy()
+            .replace('\\', "/")
+            .to_ascii_lowercase();
+        if normalized.ends_with("/system32/bash.exe")
+            || normalized.ends_with("/sysnative/bash.exe")
+            || normalized.split('/').any(|part| part == "windowsapps")
+        {
+            None
+        } else {
+            file_exists(&path)
+        }
+    })
+}
